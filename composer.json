{
    "name": "noctud/collection",
    "description": "🗺️ Type-safe, key-preserving, mutable/immutable List/Set/Map for PHP",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "slevomat/coding-standard": "^8.16"
    },
    "autoload": {
        "psr-4": {
            "Noctud\\Collection\\": "src"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Noctud\\Collection\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
